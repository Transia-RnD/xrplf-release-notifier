{
  "name": "xrplf-release-notifier",
  "version": "1.0.0",
  "private": true,
  "description": "Automated release notifications for rippled version changes",
  "scripts": {
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "serve": "NODE_ENV=development nodemon src/index.ts",
    "test": "jest --config=jest.config.js",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "check": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.14.0",
    "axios": "^1.7.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "twitter-api-v2": "^1.17.0",
    "winston": "^3.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}

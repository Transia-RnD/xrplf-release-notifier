NODE_ENV=development
PORT=3000
GCP_PROJECT_ID=
GCS_BUCKET=xrplf-release-notifier
APP_SECRET_VERSION=latest

# For local development only (production uses GCP Secret Manager)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
MATTERMOST_WEBHOOK_URL=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
ANTHROPIC_API_KEY=

# Shared secret between Cloud Scheduler and the /poll endpoint.
# Generate with: openssl rand -hex 32
# The Cloud Scheduler job must send this in the X-Cloud-Scheduler-Token header.
# If unset in production, /poll is callable by anyone — only leave blank in dev.
# Also guards the /parity worker endpoint.
POLLER_TOKEN=

# Base URL the webhook uses to dispatch the SDK parity job to its own /parity
# worker (fire-and-forget). Defaults to the request's own host, which is correct
# on Cloud Run; override only if self-calls need a different URL.
SELF_URL=

# --- WhatsApp pager (off unless PAGER_ENABLED=true) ---
# Every key below must be set when enabled; a partial set fails at startup
# rather than silently dropping alerts.
PAGER_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Account auth token. Only used to validate inbound Twilio signatures.
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_CHANNEL=whatsapp
# Approved template; business-initiated WhatsApp is rejected without one.
TWILIO_ALERT_TEMPLATE_SID=
# Roster encryption. Generate with: ts-node scripts/sms-roster.ts keygen
# Rotating SMS_INDEX_PEPPER invalidates every blind index — do not.
SMS_ENC_KEYS=
SMS_INDEX_PEPPER=

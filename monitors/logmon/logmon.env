# logmon configuration — node-agnostic. Source this from run.sh / rotate.sh.
# Defaults below target alphanet vnode1; override for a dedicated log node.

# Path to the node's live debug log (host side of the docker volume mount).
LOGMON_LOG="${LOGMON_LOG:-/Users/infinityworks/projects/xrplf/xrpld-lab/workspace/alphanet-cluster/vnode1/log/debug.log}"

# Admin RPC endpoint that accepts the `logrotate` command (port_rpc_admin_local).
LOGMON_ADMIN_RPC="${LOGMON_ADMIN_RPC:-http://127.0.0.1:5105}"

# Where rotated/gzipped archives are kept.
LOGMON_ARCHIVE="${LOGMON_ARCHIVE:-$(dirname "$LOGMON_LOG")/archive}"

# Where parsed hourly JSONL is written (DuckDB reads this glob).
LOGMON_JSONL="${LOGMON_JSONL:-$(dirname "$LOGMON_LOG")/jsonl}"

# Node/host label stamped onto every parsed record.
LOGMON_HOST="${LOGMON_HOST:-vnode1}"

# Rotate once the live log reaches this many bytes (default 512 MiB).
LOGMON_MAX_BYTES="${LOGMON_MAX_BYTES:-536870912}"

# Delete gzipped archives older than this many days (0 = never prune).
LOGMON_RETAIN_DAYS="${LOGMON_RETAIN_DAYS:-7}"

[Unit]
Description=xrpl-crawler nunl — Negative UNL (validators disabled/re-enabled) tracking
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=observatory
EnvironmentFile=/etc/observatory.env
ExecStart=/opt/observatory/bin/xrpl-crawler nunl \
  --endpoint https://s1.ripple.com:51234 \
  --state-file /var/lib/observatory/nunl-state.json \
  $MONITOR_FLAGS \
  --webhook-state /var/lib/observatory/nunl-alert-state.json
StateDirectory=observatory
